# ---------------------------------------------------------------------------
# BookLeaf Author Support Portal — local environment.
# Copy to `.env` and fill in real values. `.env` is gitignored: never commit it.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/bookleaf
DB_USERNAME=bookleaf
DB_PASSWORD=bookleaf

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=bookleaf-portal
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P7D
# true in production (HTTPS-only refresh cookie)
SECURE_COOKIES=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding ---------------------------------------------------------------
SEED_ENABLED=true
SEED_AUTHOR_PASSWORD=Author@1234
SEED_ADMIN_PASSWORD=Admin@1234

# --- AI provider -----------------------------------------------------------
# The provider is auto-detected from whichever key is present.
# With neither key set the portal runs in deterministic fallback mode:
# tickets are classified by the built-in rules and replies are written by hand.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-purpose overrides (blank = use the provider default)
AI_TRIAGE_MODEL=
AI_DRAFT_MODEL=
AI_TRIAGE_MAX_TOKENS=300
AI_DRAFT_MAX_TOKENS=700
AI_REQUEST_TIMEOUT=PT20S
AI_KB_TOP_SECTIONS=3

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
