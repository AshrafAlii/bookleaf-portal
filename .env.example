# ---------------------------------------------------------------------------
# BookLeaf Author Support Portal — local environment.
# Copy to `.env` and fill in real values. `.env` is gitignored: never commit it.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/bookleaf
DB_USERNAME=bookleaf
DB_PASSWORD=bookleaf

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=bookleaf-portal
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P7D
# true in production (HTTPS-only refresh cookie)
SECURE_COOKIES=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding ---------------------------------------------------------------
SEED_ENABLED=true
SEED_AUTHOR_PASSWORD=Author@1234
SEED_ADMIN_PASSWORD=Admin@1234

# --- AI provider -----------------------------------------------------------
# The provider is auto-detected from whichever key is present.
# With neither key set the portal runs in deterministic fallback mode:
# tickets are classified by the built-in rules and replies are written by hand.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-purpose overrides (blank = use the provider default)
AI_TRIAGE_MODEL=
AI_DRAFT_MODEL=
AI_TRIAGE_MAX_TOKENS=300
AI_DRAFT_MAX_TOKENS=700
AI_REQUEST_TIMEOUT=PT20S
# How many LLM calls may run at once. Keep it at 1 for a self-hosted model:
# a second concurrent request needs its own copy of the context in RAM.
AI_MAX_CONCURRENT_CALLS=1
# Classify in the background so raising a ticket never blocks on the model.
# Set to false with a fast hosted model to get the AI classification in the
# response itself.
AI_TRIAGE_ASYNC=true

# --- Local model (Ollama) --------------------------------------------------
# Ollama speaks the OpenAI API, so no code change is needed:
#   ollama serve          (or ./scripts/ollama-tuned.sh on a small machine)
#   ollama pull qwen2.5:3b
# Then point the OpenAI settings at it:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434
# OPENAI_MODEL=qwen2.5:3b
#
# Model size vs. memory (measured on an 8 GB Apple Silicon machine):
#   qwen2.5:3b   1.9 GB   ~2.0 GB resident   10/10 category, 8/10 priority
#   llama3.1:8b  4.9 GB   ~4.2 GB resident   10/10 category, 10/10 priority
# A hosted model is better on both counts — no local memory cost at all.
AI_KB_TOP_SECTIONS=3

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
