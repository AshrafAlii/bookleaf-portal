# ---------------------------------------------------------------------------
# BookLeaf Author Support Portal — environment template.
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/bookleaf
DB_USERNAME=bookleaf
DB_PASSWORD=bookleaf

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=bookleaf-portal
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P7D
# Set to true in production so the refresh cookie is HTTPS-only
SECURE_COOKIES=false
# Comma-separated list of allowed browser origins (only needed when the SPA is
# served from a different origin than the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding ---
SEED_ENABLED=true
SEED_AUTHOR_PASSWORD=Author@1234
SEED_ADMIN_PASSWORD=Admin@1234

# --- AI provider ---------------------------------------------------------
# Leave both keys empty to run in deterministic fallback mode (no network calls).
# The provider is auto-detected: Anthropic wins if its key is set, then OpenAI.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-purpose model overrides (blank = use the provider default)
AI_TRIAGE_MODEL=
AI_DRAFT_MODEL=
AI_TRIAGE_MAX_TOKENS=300
AI_DRAFT_MAX_TOKENS=700
AI_REQUEST_TIMEOUT=PT20S
AI_KB_TOP_SECTIONS=3

# --- Misc ---
LOG_LEVEL=INFO
